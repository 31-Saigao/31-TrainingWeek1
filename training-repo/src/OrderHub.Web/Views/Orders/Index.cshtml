@model OrderListViewModel
@{
    ViewData["Title"] = "訂單列表";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">訂單列表</h1>
    <a class="btn btn-primary" asp-action="Create">建立訂單</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select" onchange="this.form.submit()">
            @if (Model.Status is null)
            {
                <option value="" selected>全部狀態</option>
            }
            else
            {
                <option value="">全部狀態</option>
            }
            @foreach (var status in Enum.GetValues<OrderStatus>())
            {
                if (Model.Status == status)
                {
                    <option value="@status" selected>@StatusLabel(status)</option>
                }
                else
                {
                    <option value="@status">@StatusLabel(status)</option>
                }
            }
        </select>
    </div>
    <noscript>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">篩選</button>
        </div>
    </noscript>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>編號</th>
            <th>客戶</th>
            <th>狀態</th>
            <th class="text-end">金額</th>
            <th class="text-end">品項數</th>
            <th>建立時間</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Orders.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">沒有符合條件的訂單</td>
            </tr>
        }
        @foreach (var order in Model.Orders)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td>
                <td>@order.CustomerName</td>
                <td><span class="badge @StatusBadgeClass(order.Status)">@StatusLabel(order.Status)</span></td>
                <td class="text-end">@Money(order.Total)</td>
                <td class="text-end">@order.ItemCount</td>
                <td>@LocalTime(order.CreatedAt)</td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <div class="text-muted">
        共 @Model.TotalCount 筆，第 @Model.Page / @Model.TotalPages 頁
    </div>
    <nav aria-label="分頁">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.Status">上一頁</a>
            </li>
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-status="@Model.Status">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.Status">下一頁</a>
            </li>
        </ul>
    </nav>
</div>
